#!/usr/bin/env bash
set -e

cd "$(dirname "$0")/.."

mise exec -- bundle exec standardrb "$@"

mapfile -t shell_scripts < <(grep -l '^#!/usr/bin/env bash' gems/*/libexec/* gems/*/lib/generators/*/*/templates/* 2>/dev/null)
if [ "${#shell_scripts[@]}" -gt 0 ]; then
  mise exec -- shellcheck "${shell_scripts[@]}"
fi
