#!/usr/bin/env bash
# Usage: bin/release 0.2.0
# Apps pin to the tag, so it must point at a commit where VERSION already matches.
set -euo pipefail
cd "$(dirname "$0")/.."

version="${1:?usage: bin/release <version>}"
tag="v$version"

[ "$(git branch --show-current)" = "main" ] || { echo "release from main"; exit 1; }
[ -z "$(git status --porcelain)" ] || { echo "working tree not clean"; exit 1; }
[ "$(cat VERSION)" = "$version" ] || { echo "VERSION says $(cat VERSION), bump it and commit first"; exit 1; }
git rev-parse "$tag" >/dev/null 2>&1 && { echo "$tag already exists"; exit 1; }

bin/ci
git tag -a "$tag" -m "$tag"
git push origin main "$tag"
echo "released $tag"
