#!/usr/bin/env ruby
# Summary: Rebuild the test database and install the test browser for bin/ci
# frozen_string_literal: true

require "fileutils"

puts "Setting up minimal CI environment..."

FileUtils.mkdir_p("tmp")

# Rebuild the test DB from schema.rb so the consistency check and the
# test suite both run against a DB that matches this branch only. Skips
# seeds; a separate seeds step exercises those.
system({"RAILS_ENV" => "test"}, "bin/rails db:drop db:create db:schema:load") || exit(1)

# Pinned browser for the system-test step; no-op once installed.
system("bin/studio install-test-browser") || exit(1)

puts "✓ CI setup complete"
