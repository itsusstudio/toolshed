#!/usr/bin/env bash
# Summary: Edit an environment's credentials with its key from 1Password
# Usage: credentials-edit <development|test|staging|production>
set -euo pipefail

ENVIRONMENT="${1:-}"

RAILS_KEYS_OP_REF="${RAILS_KEYS_OP_REF:-op://itsusstudio/rails-master-keys-${STUDIO_APP}}"

if [[ -z "$ENVIRONMENT" ]]; then
  echo "Usage: bin/studio credentials-edit <environment>"
  echo "       environments: development, test, staging, production"
  exit 1
fi

case "$ENVIRONMENT" in
  development|test|staging|production) ;;
  *)
    echo "Error: unknown environment '$ENVIRONMENT'"
    echo "Valid environments: development, test, staging, production"
    exit 1
    ;;
esac

SECRET_REF="$RAILS_KEYS_OP_REF/$ENVIRONMENT"

RAILS_MASTER_KEY="$SECRET_REF" op run -- bin/rails credentials:edit --environment "$ENVIRONMENT"
