#!/usr/bin/env bash
# Summary: Rebuild the development database from schema.rb, migrate and seed
set -euo pipefail

if [ "${RAILS_ENV:-development}" != "development" ]; then
  echo "❌ db-reset only runs against development (RAILS_ENV=${RAILS_ENV})"
  exit 1
fi

export LAUNCHY_DRY_RUN=1

echo "Restoring schema.rb to HEAD..."
git checkout db/schema.rb

echo "Terminating other connections to ${STUDIO_APP}_development databases..."
docker compose exec -T db psql \
  -U "${POSTGRES_USER:-postgres}" \
  -d postgres \
  -v ON_ERROR_STOP=1 \
  -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname LIKE '${STUDIO_APP}_development%' AND pid <> pg_backend_pid();" >/dev/null

echo "Resetting database..."
bin/rails db:drop:primary db:create:primary db:schema:load:primary

echo "Running pending migrations..."
bin/rails db:migrate:primary

echo "Seeding database..."
bin/rails db:seed

if [ -n "${STUDIO_FLIPPER:-}" ]; then
  echo "Registering feature flags..."
  bin/rails flipper:sync
fi

echo "Done."
