#!/usr/bin/env bash
# Summary: Write the development and test master keys from 1Password
set -euo pipefail
umask 077

RAILS_KEYS_OP_REF="${RAILS_KEYS_OP_REF:-op://itsusstudio/rails-master-keys-${STUDIO_APP}}"
CREDENTIALS_DIR="config/credentials"

if ! command -v op &>/dev/null; then
  echo "❌ 1Password CLI (op) is not installed."
  echo "   ↳ Install the 1Password CLI: https://developer.1password.com/docs/cli/get-started/"
  exit 1
fi

mkdir -p "$CREDENTIALS_DIR"

fetch_key() {
  local env="$1"
  local key

  if ! key="$(op read "${RAILS_KEYS_OP_REF}/${env}")"; then
    echo "❌ Could not read ${RAILS_KEYS_OP_REF}/${env}" >&2
    exit 1
  fi

  if [[ -z "$key" ]]; then
    echo "❌ ${env} key is empty" >&2
    exit 1
  fi

  printf '%s\n' "$key" > "$CREDENTIALS_DIR/${env}.key"
  # umask only covers new files; tighten keys written by an older run.
  chmod 600 "$CREDENTIALS_DIR/${env}.key"
}

fetch_key "development" & dev_pid=$!
fetch_key "test" & test_pid=$!
wait "$dev_pid"
wait "$test_pid"
