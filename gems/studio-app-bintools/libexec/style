#!/usr/bin/env bash
# Summary: Fix style: standardrb, herb, i18n-tasks, biome
# Auto-fix style. lint is the verifying counterpart; keep the two in sync.
set -e

mise exec -- bundle exec standardrb --fix

mise exec -- herb-lint --simple --fix .

mise exec -- herb-format .

mise exec -- bundle exec i18n-tasks normalize

mise exec -- biome check --write
