<% config = Studio::Auth.config %>
<% languages = I18n.available_locales.map { |code| [t("studio_auth.language_name", locale: code, default: code.to_s.upcase), code] } %>

<% content_for :studio_auth_page do %>
  <div class="u-auth-shell">
    <% if languages.many? %>
      <%= form_with url: request.path, method: :get, id: "studio-auth-language", class: "u-auth-shell-language" do %>
        <%= select_tag :locale, options_for_select(languages, I18n.locale), class: "u-input u-language-select", aria: {label: t("studio_auth.language")} %>
      <% end %>
    <% end %>
    <header>
      <%= link_to config.app_name, main_app.root_path, class: "u-wordmark u-wordmark-lg u-wordmark-#{config.wordmark_style}" %>
      <% if I18n.exists?("studio_auth.blurb") %>
        <p class="u-text-section-title"><%= t("studio_auth.blurb") %></p>
      <% end %>
    </header>

    <main id="studio-auth-page">
      <%= yield %>
    </main>

    <footer>
      <p>
        <%= link_to t("studio_auth.terms"), Studio::Uniform::TERMS_URL, target: "_blank", rel: "noopener" %> — <%= link_to t("studio_auth.privacy"), Studio::Uniform::PRIVACY_URL, target: "_blank", rel: "noopener" %>
      </p>
    </footer>
  </div>
<% end %>

<%= render template: "layouts/uniform" %>
