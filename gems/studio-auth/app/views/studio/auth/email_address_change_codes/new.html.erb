<% scope = "studio_auth.email_address_change_codes.new.#{@change.step}" %>
<% content_for :page_title, t("#{scope}.title") %>

<hgroup>
  <h1 id="studio-auth-email-change-code-title" class="text-page-title"><%= t("#{scope}.title") %></h1>
  <p id="studio-auth-email-change-code-sent-to" class="text-small">
    <%= t("#{scope}.sent_to_html", email_address: tag.strong(@change.code_sent_to(current_user), class: "font-medium")) %>
  </p>
</hgroup>

<%= uniform_form_with url: main_app.verify_email_address_change_path, id: "studio-auth-email-change-code-form", html: {novalidate: true} do |form| %>
  <%= form.code_field :code,
        label: t("studio_auth.codes.new.code_label"),
        value: params[:code],
        error: with_line_breaks(@field_error),
        submit: true,
        required: true,
        autofocus: true %>
  <%= form.button t("#{scope}.submit"), id: "studio-auth-email-change-code-submit", class: "u-btn u-btn-primary" %>
<% end %>

<%= form_with url: main_app.resend_email_address_change_code_path, id: "studio-auth-email-change-resend-form", class: "text-small" do |form| %>
  <%= t("studio_auth.codes.new.resend_prompt") %>
  <%= form.button t("studio_auth.codes.new.resend"), class: "u-link-btn" %>
<% end %>

<% if @change.dev_code %>
  <p id="studio-auth-dev-code" class="text-small"><%= t("studio_auth.codes.new.dev_code", code: @change.dev_code) %></p>
<% end %>
