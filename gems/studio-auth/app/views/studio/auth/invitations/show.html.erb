<% place = (@invitation.user.try(:invitation_details) || {}).fetch(:place, Studio::Auth.config.app_name) %>
<% content_for :page_title, t("studio_auth.invitations.show.title", place: place) %>

<hgroup>
  <h1 id="studio-auth-invitation-title" class="u-text-page-title">
    <%= t("studio_auth.invitations.show.title", place: place) %>
  </h1>
  <p class="u-text-small">
    <%= t("studio_auth.invitations.show.signs_in_as_html", email_address: tag.strong(@invitation.email_address, class: "u-text-strong"), app_name: Studio::Auth.config.app_name) %>
  </p>
</hgroup>

<%= button_to t("studio_auth.invitations.show.join", place: place), main_app.invitation_path(token: params[:token]),
      method: :patch, id: "studio-auth-invitation-join", class: "u-btn u-btn-primary" %>
