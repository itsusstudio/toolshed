<% content_for :page_title, t("studio_auth.sign_ins.no_account.title", app_name: Studio::Auth.config.app_name) %>

<hgroup>
  <h1 id="studio-auth-no-account-title" class="u-text-page-title">
    <%= t("studio_auth.sign_ins.no_account.title", app_name: Studio::Auth.config.app_name) %>
  </h1>
  <p id="studio-auth-no-account-email" class="u-text-small">
    <%= t("studio_auth.sign_ins.no_account.body", email_address: @new_account_email_address) %>
  </p>
</hgroup>

<div class="u-stack u-gap-3">
  <%= link_to t("studio_auth.sign_ins.no_account.create"), main_app.signup_path,
        id: "studio-auth-no-account-create", class: "u-btn u-btn-primary" %>
  <%= link_to t("studio_auth.sign_ins.no_account.change"), main_app.login_path,
        id: "studio-auth-no-account-change", class: "u-btn u-btn-outline" %>
</div>
