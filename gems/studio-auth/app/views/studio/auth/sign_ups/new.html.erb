<% content_for :page_title, t("studio_auth.sign_ups.new.title", app_name: Studio::Auth.config.app_name) %>

<hgroup>
  <h1 id="studio-auth-sign-up-title" class="text-page-title"><%= t("studio_auth.sign_ups.new.heading") %></h1>
  <% if @no_account_email_address %>
    <p id="studio-auth-sign-up-no-account" class="text-small"><%= t("studio_auth.sign_ups.new.no_account", email_address: @no_account_email_address) %></p>
  <% end %>
  <%= page_message %>
</hgroup>

<%# novalidate: browsers reject addresses typed with Arabic or Thai digits or invisible marks and block the submit silently; the server normalizes them. %>
<%= uniform_form_with url: main_app.signup_path, id: "studio-auth-sign-up-form", html: {novalidate: true} do |form| %>
  <%= form.text_field :full_name,
        label: t("studio_auth.sign_ups.new.full_name_label"),
        value: @form&.full_name,
        error: field_error(@form, :full_name, max: Studio::Auth::SignUpForm::FULL_NAME_MAX_LENGTH),
        required: true,
        autofocus: true,
        autocomplete: "name" %>
  <%= form.email_field :email_address,
        label: t("studio_auth.sign_ups.new.email_label"),
        value: @form&.email_address,
        error: with_line_breaks(@field_error || field_error(@form, :email_address)),
        required: true,
        autocomplete: "email" %>
  <u-time-zone><%= form.hidden_field :time_zone, value: @form&.time_zone %></u-time-zone>
  <%= form.button t("studio_auth.sign_ups.new.submit"), id: "studio-auth-sign-up-submit", class: "u-btn u-btn-primary" %>
<% end %>

<p id="studio-auth-sign-in" class="text-small"><%= sign_in_prompt %></p>
