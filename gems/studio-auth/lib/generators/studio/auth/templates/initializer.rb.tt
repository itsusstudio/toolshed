Studio::Auth.configure do |c|
  c.app_name = ""
  c.mail_from = ""
  # The sender's name, street and city, one line each, at the foot of mail.
  c.mail_address = ["", "", ""]
  # The app's Uniform document layout, and its name's wordmark voice.
  c.page_layout = "application"
  c.wordmark = "serif"
  c.terms_url = ""
  c.privacy_url = ""
  # true takes new accounts at /signup; false is invite-only.
  c.sign_up = true
  # 20.years keeps sessions until sign-out; shorter, e.g. 30.days idle and
  # 90.days absolute, for apps holding sensitive data.
  c.session_idle_timeout = 20.years
  c.session_absolute_timeout = 20.years
end
